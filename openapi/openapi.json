        "summary": "Last N mid prices of every instrument of the broker, in one call (for the markets list)",
        "operationId": "sparklines",
        "parameters": [
          {
            "name": "points",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 60,
              "maximum": 240,
              "minimum": 2
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
