{
  "openapi": "3.1.0",
  "info": {
    "title": "TradeChameleon API",
    "description": "Multi-tenant, white-label training trading platform.\n\n**Tenant** is resolved from the `*.localhost` subdomain, `?tenant=`, the `X-Tenant-Id` header or the default (aurora).\n\n**Auth**: `POST /api/auth/token` with `trader@aurora.test` / `demo`, then use the `accessToken` as a Bearer token. Errors are RFC 9457 Problem Details.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Market",
      "description": "Instruments, quotes, history and live prices (SSE)"
    },
    {
      "name": "Portfolio",
      "description": "Cash, positions and valuation"
    },
    {
      "name": "Auth",
      "description": "Built-in development identity provider (RS256 JWT)"
    },
    {
      "name": "Tenants",
      "description": "White-label brokers and their branding"
    },
    {
      "name": "Simulator",
      "description": "Latency, failure and volatility simulator for the dev panel"
    },
    {
      "name": "Orders",
      "description": "Market and limit orders"
    }
  ],
  "paths": {
    "/api/simulator": {
      "get": {
        "tags": [
          "Simulator"
        ],
        "summary": "Current simulator settings",
        "operationId": "get",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatorSettings"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "Simulator"
        ],
        "summary": "Replace simulator settings",
        "operationId": "put",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulatorSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatorSettings"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/simulator/reset": {
      "post": {
        "tags": [
          "Simulator"
        ],
        "summary": "Back to defaults: no latency, no failures, normal volatility",
        "operationId": "reset",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatorSettings"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Orders of the caller, newest first",
        "operationId": "list",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "FILLED",
                "CANCELLED",
                "REJECTED"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 500,
              "minimum": 1
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Place a market or limit order (role TRADER, tenant feature 'trading')",
        "operationId": "place",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
