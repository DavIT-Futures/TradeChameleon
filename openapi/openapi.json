nstruments the current broker offers, with live quotes","operationId":"instruments","parameters":[{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/InstrumentView"}}}}}}}},"/api/market/instruments/{symbol}":{"get":{"tags":["Market"],"summary":"One instrument with its quote","operationId":"instrument","parameters":[{"name":"symbol","in":"path","required":true,"schema":{"type":"string"}},{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstrumentView"}}}}}}},"/api/market/instruments/{symbol}/options":{"get":{"tags":["Market"],"summary":"Option chain (Black-Scholes prices and greeks) for an optionable underlying","description":"Read-only. expiry is one of the returned expiries (ISO date); default = the second one.","operationId":"optionChain","parameters":[{"name":"symbol","in":"path","required":true,"schema":{"type":"string"}},{"name":"expiry","in":"query","required":false,"schema":{"type":"string","format":"date"}},{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OptionChain"}}}}}}},"/api/market/instruments/{symbol}/history":{"get":{"tags":["Market"],"summary":"Recent mid prices (one point per engine tick) for sparklines and charts","operationId":"history","parameters":[{"name":"symbol","in":"path","required":true,"schema":{"type":"string"}},{"name":"points","in":"