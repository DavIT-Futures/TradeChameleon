{"openapi":"3.1.0","info":{"title":"TradeChameleon API","description":"Multi-tenant, white-label training trading platform.\n\n**Tenant** is resolved from the `*.localhost` subdomain, `?tenant=`, the `X-Tenant-Id` header or the default (aurora).\n\n**Auth**: `POST /api/auth/token` with `trader@aurora.test` / `demo`, then use the `accessToken` as a Bearer token. Errors are RFC 9457 Problem Details.","license":{"name":"MIT"},"version":"1.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Watchlist","description":"Instruments the user follows"},{"name":"Market","description":"Instruments, quotes, history and live prices (SSE)"},{"name":"Portfolio","description":"Cash, positions, protection, account statement and realised P&L"},{"name":"Alerts","description":"Price alerts and in-app notifications"},{"name":"Insights","description":"Economic calendar and market news"},{"name":"Auth","description":"Built-in development identity provider (RS256 JWT)"},{"name":"Tenants","description":"White-label brokers and their branding"},{"name":"Simulator","description":"Latency, failure and volatility simulator for the dev panel"},{"name":"Orders","description":"Market and limit orders"},{"name":"Admin","description":"Platform operator view of all brokers (role ADMIN)"}],"paths":{"/api/watchlist/{symbol}":{"put":{"tags":["Watchlist"],"summary":"Add a symbol (idempotent)","operationId":"add","parameters":[{"name":"symbol","in":"path","required":true,"schema":{"type":"string"}},{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"responses":{"204":{"description":"No Content"}},"security":[{"bearer":[]}]},"delete":{"tags":["Watchlist"],"summary":"Remove a symbol (idempotent)","operationId":"remove","parameters":[{"name":"symbol","in":"path","required":true,"schema":{"type":"string"}},{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"responses":{"204":{"description":"No Content"}},"security":[{"bearer":[]}]}},"/api/simulator":{"get":{"tags":["Simulator"],"summary":"Current simulator settings","operationId":"get","parameters":[{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SimulatorSettings"}}}}},"security":[{"bearer":[]}]},"put":{"tags":["Simulator"],"summary":"Replace simulator settings","operationId":"put","parameters":[{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimulatorSettings"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SimulatorSettings"}}}}},"security":[{"bearer":[]}]}},"/api/portfolio/positions/{symbol}/protection":{"put":{"tags":["Portfolio"],"summary":"Set or remove stop-loss / take-profit on an open position (role TRADER)","operationId":"protect","parameters":[{"name":"symbol","in":"path","required":true,"schema":{"type":"string"}},{"name":"X-Tenant-Id","in":"header","description":"Broker id (aurora, kestrel, wisla, sakura). Optional: subdomain or ?tenant= work too.","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProtectionRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PortfolioView"}}}}},"security":[{"bearer":[]}]}},"/api/admin/tenants/{id}":{"p