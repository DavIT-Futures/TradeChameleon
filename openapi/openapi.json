  "components": {
    "schemas": {
      "SimulatorSettings": {
        "type": "object",
        "properties": {
          "latencyMs": {
            "type": "integer",
            "format": "int32",
            "maximum": 10000,
            "minimum": 0
          },
          "jitterMs": {
            "type": "integer",
            "format": "int32",
            "maximum": 10000,
            "minimum": 0
          },
          "failureRate": {
            "type": "number",
            "format": "double",
            "maximum": 1,
            "minimum": 0
          },
          "volatilityMultiplier": {
            "type": "number",
            "format": "double",
            "maximum": 20,
            "minimum": 0
          },
          "paused": {
            "type": "boolean"
          }
        },
        "required": [
          "failureRate",
          "jitterMs",
          "latencyMs",
          "paused",
          "volatilityMultiplier"
        ]
      },
      "PlaceOrderRequest": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT"
            ]
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "limitPrice": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "quantity",
          "side",
          "symbol",
          "type"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT"
            ]
          },
          "quantity": {
            "type": "number"
          },
          "limitPrice": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "FILLED",
              "CANCELLED",
              "REJECTED"
            ]
          },
          "fillPrice": {
            "type": [
              "number",
              "null"
            ]
          },
          "rejectReason": {
            "type": [
